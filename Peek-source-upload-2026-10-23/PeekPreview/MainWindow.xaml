<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PeekPreview.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Peek">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent" KeyDown="Root_KeyDown">
        <Image x:Name="ImagePreview"
               Stretch="Uniform"
               Visibility="Collapsed"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <ListView x:Name="ArchivePreview"
                  Visibility="Collapsed"
                  Margin="24,46,24,24"
                  Background="Transparent"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="18" Padding="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Size}" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <MediaPlayerElement x:Name="MediaPreview"
                            AreTransportControlsEnabled="True"
                            AutoPlay="True"
                            Stretch="Uniform"
                            Visibility="Collapsed" />

        <WebView2 x:Name="WebPreview"
                  Visibility="Collapsed" />

        <TextBox x:Name="TextPreview"
                 Visibility="Collapsed"
                 Margin="26,46,26,24"
                 Padding="18"
                 IsReadOnly="True"
                 IsTabStop="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"
                 Background="#80202020"
                 BorderThickness="0" />

        <StackPanel x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
            <TextBlock x:Name="EmptyTitle"
                       Text="Peek"
                       FontSize="32"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyDescription"
                       Text="Select a file in File Explorer and press Space."
                       FontSize="16"
                       Opacity="0.78"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>

        <Border x:Name="FileBadge"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="0"
                Height="34"
                Padding="12,0"
                CornerRadius="0"
                Background="#CC202020"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Peek" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="·" Opacity="0.65" />
                <TextBlock x:Name="FileName"
                           FontSize="13"
                           MaxWidth="720"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
